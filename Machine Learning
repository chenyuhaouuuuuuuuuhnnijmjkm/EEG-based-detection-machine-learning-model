#---------------Data Operation---------------
def butter_bandpass_filter(signal, lowcut, highcut, fs, order=3):
    nyq = 0.5 * fs
    low = lowcut / nyq
    high = highcut / nyq
    b, a = butter(order, [low, high], btype='band')
    y = lfilter(b, a, signal, axis=-1)
    return y

def dataprocess(data, Fs):
    # Zero-mean
    for i in range(data.shape[0]):
        for j in range(data.shape[1]):
            data[i, j] = data[i, j] - np.mean(data[i, j])
    data = butter_bandpass_filter(data, 5, 40, Fs)
    return data

#--------------Function -----------------------
def get_FFT(y, Fs):
    N = np.size(y)
    record_time = N/Fs
    dt = 1/Fs # sampling interval
    x = np.arange(0, record_time, dt)
    
    #plot_signal(x,y,'Time Domain of the signal','t(s)','Amplitude','time_pic')
    
    y_f = scipy.fft.fft(y)
    y_f = 2.0/N * np.abs(y_f[:N//2])
    x_f = np.linspace(0.0, 1.0/(2.0/Fs), N//2)
    print(x_f.shape)
    
    return x_f, y_f

def get_PSD(y, Fs, nperseg=2048):
    f, Pxx = welch(y, Fs, nperseg=nperseg)
    return f, Pxx

def snr_spectrum(psd, noise_n_neighbor_freqs=1, noise_skip_neighbor_freqs=1):
    # Construct a kernel that calculates the mean of the neighboring
    # frequencies
    averaging_kernel = np.concatenate(
        (
            np.ones(noise_n_neighbor_freqs),
            np.zeros(2 * noise_skip_neighbor_freqs + 1),
            np.ones(noise_n_neighbor_freqs),
        )
    )
    averaging_kernel /= averaging_kernel.sum()

    mean_noise = np.apply_along_axis(
        lambda psd_: np.convolve(psd_, averaging_kernel, mode="valid"), axis=-1, arr=psd
    )

    edge_width = noise_n_neighbor_freqs + noise_skip_neighbor_freqs
    pad_width = [(0, 0)] * (mean_noise.ndim - 1) + [(edge_width, edge_width)]
    mean_noise = np.pad(mean_noise, pad_width=pad_width, constant_values=np.nan)

    return psd / mean_noise

def generate_harmonics(freq, length, Fs, num_harmonics=9):
    t = np.linspace(0, length / Fs, length, endpoint=False)
    harmonics = []
    for i in range(1, num_harmonics + 1):
        harmonics.append(np.sin(2 * i * np.pi * freq * t))
        harmonics.append(np.cos(2 * i * np.pi * freq * t))
    harmonics = np.vstack(harmonics)
    return harmonics

