# 新的 CCA 分析函数
def perform_cca_analysis(data, frequencies, sampling_rate):
    def getReferenceSignals(length, target_freq):
        reference_signals = []
        t = np.arange(0, (length / sampling_rate), step=1.0 / sampling_rate)
        reference_signals.append(np.sin(np.pi * 2 * target_freq * t))
        reference_signals.append(np.cos(np.pi * 2 * target_freq * t))

        # 添加第二諧波的參考訊號
        reference_signals.append(np.sin(np.pi * 4 * target_freq * t))
        reference_signals.append(np.cos(np.pi * 4 * target_freq * t))

        # 添加第三諧波的參考訊號
        reference_signals.append(np.sin(np.pi * 6 * target_freq * t))
        reference_signals.append(np.cos(np.pi * 6 * target_freq * t))

        # 添加第四諧波的參考訊號
        reference_signals.append(np.sin(np.pi * 8 * target_freq * t))
        reference_signals.append(np.cos(np.pi * 8 * target_freq * t))
        
        reference_signals = np.array(reference_signals)
        return reference_signals

    def findCorr(n_components, numpyBuffer, freq):
        cca = CCA(n_components)
        corr = np.zeros(n_components)
        result = np.zeros((freq.shape)[0])
        for freqIdx in range(0, (freq.shape)[0]):
            cca.fit(numpyBuffer.T, np.squeeze(freq[freqIdx, :, :]).T)
            O1_a, O1_b = cca.transform(numpyBuffer.T, np.squeeze(freq[freqIdx, :, :]).T)
            indVal = 0
            for indVal in range(0, n_components):
                corr[indVal] = np.corrcoef(O1_a[:, indVal], O1_b[:, indVal])[0, 1]
            result[freqIdx] = np.max(corr)
        return result

    n_components = 1
    signal_length = data.shape[1]
    all_reference_signals = np.array([getReferenceSignals(signal_length, freq) for freq in frequencies])
    cca_results = []

    for i in range(data.shape[0]):
        segment = data[i].reshape(1, -1) 
        result = findCorr(n_components, segment, all_reference_signals)
        max_result = max(result, key=float)
        predicted_class = np.argmax(result) + 1
        cca_results.append((predicted_class, max_result))
    
    return cca_results

