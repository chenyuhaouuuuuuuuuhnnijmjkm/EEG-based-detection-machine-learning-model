#----------------- Data Operation -------------------------
def butter_bandpass_filter(signal, lowcut, highcut, fs, order=3):
    nyq = 0.5 * fs
    low = lowcut / nyq
    high = highcut / nyq
    b, a = butter(order, [low, high], btype='band')
    y = lfilter(b, a, signal, axis=-1)
    return y

def dataprocess(data, Fs):
    # Zero-mean
    for i in range(data.shape[0]):
        for j in range(data.shape[1]):
            data[i, j] = data[i, j] - np.mean(data[i, j])
    data = butter_bandpass_filter(data, 9, 31, Fs)
    return data

def extract_feature(Ft, Fy, Fs):
    feature = []
    for i in range(3):
        for j in range(5):
            feature_freq = frequency_labels[i] + (j - 2) * 0.2  # 修改频率步长为0.2Hz
            idx = np.argmin(np.abs(Ft - feature_freq))  # 找到最接近的频率索引
            feature_freq_position = Ft[idx]
            feature_amp = Fy[idx]
            feature.append((feature_freq_position, feature_amp))
    return feature
#----------------- Function -------------------------
def get_FFT(y, Fs, desired_resolution=0.2):
    T = 1 / desired_resolution
    N = int(T * Fs)
    
    if len(y) < N:
        y = np.pad(y, (0, N - len(y)), 'constant')
    elif len(y) > N:
        y = y[:N]

    y_f = scipy.fft.fft(y)
    y_f = 2.0 / N * np.abs(y_f[:N // 2])
    x_f = np.linspace(0.0, Fs / 2, N // 2)
    
    return x_f, y_f

def get_PSD(y, Fs, nperseg=1024):
    f, Pxx = welch(y, Fs, nperseg=nperseg)
    return f, Pxx

def generate_harmonics(freq, length, Fs, num_harmonics=9):
    t = np.linspace(0, length / Fs, length, endpoint=False)
    harmonics = []
    for i in range(1, num_harmonics + 1):
        harmonics.append(np.sin(2 * i * np.pi * freq * t))
        harmonics.append(np.cos(2 * i * np.pi * freq * t))
    harmonics = np.vstack(harmonics)
    return harmonics

